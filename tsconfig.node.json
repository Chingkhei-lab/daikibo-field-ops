{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "vite.config.ts",
    "api/**/*",
    "server/src/**/*"
  ]
}
{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/debug/echo",
            "destination": "/api/debug/echo"
        },
        {
            "source": "/api/debug/fix-db",
            "destination": "/api/debug/fix-db"
        },
        {
            "source": "/api/debug/schema",
            "destination": "/api/debug/schema"
        },
        {
            "source": "/api/auth/login",
            "destination": "/api/auth/login"
        },
        {
            "source": "/api/auth/register",
            "destination": "/api/auth/register"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://your-backend-storage.com/uploads/$1"
        },
        {
            "source": "/((?!api/|assets/|favicon.ico).*)",
            "destination": "/index.html"
        }
    ]
}